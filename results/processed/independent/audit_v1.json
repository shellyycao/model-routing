  "issues": [
    {
      "finding": "29/30 model outputs are functionally correct; two explicit non-equivalent implementations pass every hidden test.",
      "id": "A1-CEILING",
      "severity": "major"
    },
    {
      "finding": "A1 record status/hard gate means code loaded, not that all tests passed; one functionally incorrect output is still status=passed.",
      "id": "A1-STATUS",
      "severity": "major"
    },
    {
      "finding": "Seven gpt-oss failures are wrapper failures with recoverable perfect content, so operational and content scores must be separate.",
      "id": "A2-CONFLATION",
      "severity": "major"
    },
    {
      "finding": "Only five synthetic document families with paired templates limit external validity.",
      "id": "A2-DIVERSITY",
      "severity": "major"
    },
    {
      "finding": "Frozen v1 compares canonical labels against paraphrased abstracts; v1.1 reclassifies documented surface forms post hoc.",
      "id": "A3-GROUNDING",
      "severity": "major"
    },
    {
      "finding": "A3 is controlled selection over synthetic candidates, not live web search.",
      "id": "A3-CONTROLLED",
      "severity": "clarification"
    },
    {
      "finding": "Mechanical labels avoid direct evaluated-model judging, but Claude-family authorship can still affect task style, difficulty, and preferred phrasing.",
      "id": "AUTHOR-BIAS",
      "severity": "major"
    }
